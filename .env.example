APP_ENV=dev
SERVICE_NAME=marketplace
LOG_LEVEL=debug
HTTP_ADDR=:8080
METRICS_ADDR=:9090
DATABASE_URL=postgres://marketplace:marketplace@localhost:5432/marketplace?sslmode=disable
REDIS_ADDR=localhost:6379
JWT_ISSUER=marketplace
JWT_AUDIENCE=marketplace-api
JWT_ACTIVE_KEY_ID=dev
IDENTITY_DEV_REVEAL_CODES=true
OUTBOX_POLL_INTERVAL=500ms
S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_BUCKET=marketplace
S3_ACCESS_KEY=marketplace
S3_SECRET_KEY=marketplace-secret
PSP_PROVIDER=sandbox
PSP_BASE_URL=http://localhost:8080/sandbox/psp
PSP_API_KEY=sandbox-api-key
PSP_WEBHOOK_SECRET=sandbox-webhook-secret
PSP_WEBHOOK_TOLERANCE=5m
PSP_WEBHOOK_ALLOWED_CIDRS=
PSP_TIMEOUT=5s
PSP_BREAKER_FAILURES=5
PSP_BREAKER_COOLDOWN=30s
PSP_SANDBOX_SERVER=true
PSP_SANDBOX_PUBLIC_URL=http://localhost:8080/sandbox/psp
PSP_SANDBOX_WEBHOOK_URL=http://localhost:8080/webhooks/payments/sandbox
CHECKOUT_RETURN_URL=http://localhost:3000/checkout/result
ORDER_RETURN_WINDOW=336h
SHIPPING_FLAT_FEE=99000
SHIPPING_FREE_THRESHOLD=1500000
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLE_RATIO=0.1
